APP_NAME="EKIP - Enterprise Knowledge Intelligence Platform 2.0"
DEBUG=True

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ekip_docs

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# LLM & Embedding
LLM_MODEL_NAME=meta-llama/Llama-3-8B-Instruct
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_MODEL=BAAI/bge-m3

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_K_RERANK=5